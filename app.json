{
  "expo": {
    "name": "Kabe",
    "slug": "kabe",
    "version": "7.0.4",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "scheme": "kabe",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "app.kabe.fitness",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FDE186",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.health.READ_STEPS",
        "android.permission.CAMERA",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_BACKGROUND_LOCATION",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_LOCATION",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK",
        "android.permission.RECORD_AUDIO"
      ],
      "package": "app.kabe.fitness",
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO_BACKGROUND",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FDE186",
          "image": "./assets/splash-icon.png",
          "imageWidth": 220,
          "dark": {
            "backgroundColor": "#171E19",
            "image": "./assets/splash-icon.png"
          }
        }
      ],
      "expo-font",
      [
        "expo-image-picker",
        {
          "photosPermission": "Kabe uses your photos so you can analyze a picture of your meal.",
          "cameraPermission": "Kabe uses the camera to photograph your meal and food barcodes.",
          "microphonePermission": "Kabe uses the microphone only when you record a video or say what you ate."
        }
      ],
      "expo-notifications",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Kabe uses your location only while you track a walk, run or ride.",
          "locationAlwaysAndWhenInUsePermission": "Kabe keeps tracking your walk, run or ride while the screen is off. Location is used only while you track.",
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true
        }
      ],
      [
        "expo-sensors",
        {
          "motionPermission": "Kabe counts your steps with your phone's built-in step counter."
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "Kabe uses the microphone only while you hold Record, to hear what you ate."
        }
      ],
      "expo-asset",
      "react-native-health-connect",
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 26
          }
        }
      ],
      "expo-dev-client",
      "expo-sharing"
    ],
    "backgroundColor": "#FDE186",
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "0d17e0dd-61ef-4a58-8fbb-5812824afe32"
      }
    },
    "owner": "kabe0909",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/0d17e0dd-61ef-4a58-8fbb-5812824afe32"
    }
  }
}
