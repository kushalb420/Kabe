# Copy to .env for local work (never commit .env). Releases take these from EAS environment variables (docs/DEPLOY.md).

# YOUR app backend (one Supabase project). Public values: safe to ship; the secret key must never go here.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_KEY=

# Local development only, when you have no backend yet: your own FREE-tier Google AI key. Not for releases.
EXPO_PUBLIC_GEMINI_KEY=
